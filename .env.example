SECRET_KEY=replace-with-a-generated-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres connection string, e.g. postgres://user:password@host:5432/dbname
# Railway injects this automatically when a Postgres service is attached.
# Leave unset (don't just set it to an empty value) to use local SQLite.
# DATABASE_URL=

# Comma-separated list of frontend origins allowed to call this API.
# Leave unset (don't just set it to an empty value) to use the local dev
# defaults (localhost:3000/5173).
# CORS_ALLOWED_ORIGINS=

OPENAI_API_KEY=replace-with-your-openai-api-key
