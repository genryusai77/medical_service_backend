SECRET_KEY=replace-with-a-generated-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres connection string, e.g. postgres://user:password@host:5432/dbname
# Railway injects this automatically when a Postgres service is attached.
# Leave unset (don't just set it to an empty value) to use local SQLite.
# DATABASE_URL=

# Comma-separated list of frontend origins allowed to call this API.
# Leave unset (don't just set it to an empty value) to use the local dev
# defaults (localhost:3000/5173).
# CORS_ALLOWED_ORIGINS=

# S3 (or S3-compatible) bucket for Doctor.photo uploads. Leave unset (don't
# just set it to an empty value) to keep using local filesystem storage.
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=
# Optional: for S3-compatible providers (Cloudflare R2, Backblaze B2,
# DigitalOcean Spaces, Railway buckets) instead of AWS.
# AWS_S3_ENDPOINT_URL=
# Optional: serve media via a CDN/custom domain instead of the bucket URL.
# AWS_S3_CUSTOM_DOMAIN=

OPENAI_API_KEY=replace-with-your-openai-api-key
